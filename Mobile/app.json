{
  "expo": {
    "name": "MindDesk",
    "slug": "minddesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EBDD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minddesk.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "MindDesk needs camera access to take profile photos and attach documents.",
        "NSPhotoLibraryUsageDescription": "MindDesk needs access to your photo library to attach images and set profile photos."
      }
    },
    "android": {
      "package": "com.minddesk.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F5EBDD"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set avatars and attach images."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "minddesk-mobile-project"
      }
    }
  }
}
