# Backend Server Port
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/studyhub?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string

# JWT Secret for Token Signing
JWT_SECRET=your_jwt_secret_key_change_in_production

# Allowed Frontend URL for CORS (Vercel deployment URL)
# Example: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ==================== CLOUD STORAGE (CLOUDINARY) ====================
# Required for production deployments on Render / Railway / Vercel.
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Maximum upload size in Megabytes per file (Default: 10)
MAX_FILE_SIZE_MB=10
